# Keys stay on the server and never go to the client.
# Vertex is ADC / google_account. API providers need keys below.

# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Vertex AI (Gemini + Vertex-hosted Claude)
# SALVO_GEMINI_MODEL=gemini-3.5-flash-lite
# SALVO_CLAUDE_MODEL=claude-opus-4-6
# SALVO_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.7-flash
# SALVO_VERTEX_CLAUDE_MODELS=claude-opus-4-6

# Anthropic API (separate from Vertex Claude)
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODELS=claude-sonnet-5,claude-opus-5

# OpenAI
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_MODELS=gpt-5.4-nano,gpt-5.6-luna,gpt-5.6-sol

# Ollama (same contract as amber_coop: /api/chat, format:json, think:false)
# OLLAMA_THINK=1 turns CoT on; Qwen often then leaves content empty.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_MODELS=llama3.1,qwen3.6:35b
